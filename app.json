{
  "expo": {
    "name": "Kraftnex Partner",
    "slug": "kraftnex-partner",
    "owner": "adityavardhanmss-team",
    "scheme": "kraftnex-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.kraftnex.partner",
      "supportsTablet": true
    },
    "android": {
      "package": "com.kraftnex.partner",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "302a21c0-3231-4f2a-98a1-b81c4a674a77"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "partner-updates",
          "color": "#07523e"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/kraftnex-logo-transparent.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/kraftnex-logo-transparent.png",
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kraftnex Partner to set your technician dispatch base."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kraftnex Partner to select technician credential and work photos.",
          "cameraPermission": "Allow Kraftnex Partner to take technician credential and work photos.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
