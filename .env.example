# Set this to the Kraftnex API origin and prefix reachable from the phone, including /api.
EXPO_PUBLIC_API_BASE_URL=

# Existing Kraftnex properties used for the partner and customer portal links.
EXPO_PUBLIC_PUBLIC_SITE_URL=
EXPO_PUBLIC_PARTNER_SITE_URL=


# Required for the native Android technician map in EAS builds. Keep this key out of EXPO_PUBLIC_ vars.
GOOGLE_MAPS_API_KEY=

# Marketplace seller app (optional): shown on the blocked-store screen and used for IFSC branch lookup
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_IFSC_LOOKUP_URL=https://ifsc.razorpay.com
